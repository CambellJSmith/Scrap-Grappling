; Engine configuration file.
; Edit through the Godot editor where practical.
config_version=5

[application]
config/name="scrap_grappling"
run/main_scene="res://scenes/main.tscn"

[display/window]
size/viewport_width=640
size/viewport_height=360
size/window_width_override=1280
size/window_height_override=720
stretch/mode="viewport"
stretch/aspect="keep"
stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=true
anti_aliasing/quality/msaa_2d=0

environment/defaults/default_clear_color=Color(0.047, 0.055, 0.051, 1)
